[Unit]
Description=NMS Collector SNMP Trap Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nms-collector/collector.env
Environment=ENV_FILE=/etc/nms-collector/collector.env
WorkingDirectory=/opt/nms-collector
ExecStart=/usr/local/bin/node /opt/nms-collector/nms-collector.js trap-forwarder
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
