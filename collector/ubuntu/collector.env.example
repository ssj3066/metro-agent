# Central NMS endpoint
# Provide NMS_URL for compatibility or set host/port components below.
# NMS_URL takes precedence when set.
NMS_SCHEME=https
NMS_HOST=metrocom.kr
NMS_PORT=7443
NMS_PATH=
# Public production endpoint is the primary route. Use fallback only when a
# site has a separate reachable NMS address. Collection never requires VPN.
NMS_URL=https://metrocom.kr:7443
NMS_FALLBACK_URL=

# TLS options for self-signed or private CA endpoints
NMS_INSECURE_TLS=false
NMS_CA_CERT_PATH=

# Required: values returned by POST /api/collectors
COLLECTOR_ID=1
COLLECTOR_TOKEN=replace-with-agent-token

# Optional metadata
COLLECTOR_HOSTNAME=
# DHCP/mobile collectors report the active route address automatically. Do not
# set this for a portable collector. A static override requires explicit opt-in.
COLLECTOR_PRIVATE_IP=
COLLECTOR_PRIVATE_IP_OVERRIDE=false
COLLECTOR_PUBLIC_IP=
COLLECTOR_SOFTWARE_VERSION=0.1.0
COLLECTOR_STATUS=active
COLLECTOR_PLATFORM=ubuntu
COLLECTOR_ROLE=hybrid
COLLECTOR_CAPABILITIES=heartbeat,syslog,snmp,trap,ping,diagnostics,edge-analysis
COLLECTOR_PURPOSE="internal edge collection server"

# Optional local features
ENABLE_FIELD_SERVER=false
ENABLE_RSYSLOG_RELAY=false
RSYSLOG_TARGET_HOST=127.0.0.1
RSYSLOG_TARGET_PORT=5514
RSYSLOG_TARGET_PROTOCOL=udp

ENABLE_SNMPTRAP_RELAY=false
SNMPTRAP_LISTEN_ADDRESS=0.0.0.0
SNMPTRAP_LISTEN_PORT=1162
SNMPTRAP_DISABLE_AUTHORIZATION=false
SNMPTRAP_COMMUNITIES=public

# Optional: remote diagnostics pulled from central NMS
REMOTE_DIAGNOSTICS_ENABLED=true
DIAGNOSTIC_POLL_INTERVAL_SECONDS=15
DIAGNOSTIC_COMMAND_LIMIT=1
DIAGNOSTIC_ALLOW_PUBLIC_TARGETS=false
DIAGNOSTIC_ALLOW_HOSTNAMES=false
DIAGNOSTIC_KT_PING_TARGET=168.126.63.1
DIAGNOSTIC_GOOGLE_PING_TARGET=8.8.8.8
DIAGNOSTIC_CAPTURE_INTERFACE=any
DIAGNOSTIC_TCPDUMP_MAX_SECONDS=15
DIAGNOSTIC_PCAP_DIR=/var/log/nms-pcap
DIAGNOSTIC_PCAP_RETENTION_HOURS=24
DIAGNOSTIC_DEFAULT_DNS_QUERY=naver.com
DIAGNOSTIC_INTERNET_PING_TARGET=1.1.1.1
DIAGNOSTIC_INTERNET_TEST_URL=https://www.naver.com/
DIAGNOSTIC_NMS_TARGET=
DIAGNOSTIC_ALLOW_RAW_TCPDUMP_FILTER=false

# Optional remote administration. Collection itself never depends on VPN.
REMOTE_MANAGEMENT_MODE=none
REMOTE_MANAGEMENT_PROFILE_LABEL=
WIREGUARD_INTERFACE=metro-omada
WIREGUARD_HANDSHAKE_STALE_SECONDS=180

# Optional: internal edge-server analysis
EDGE_SERVER_MODE=true
EDGE_ANALYSIS_ENABLED=true
EDGE_STANDARD_DIAGNOSTIC_ENABLED=true
EDGE_STANDARD_DIAGNOSTIC_GOAL=firewall-standard-check
EDGE_DISK_WARN_PCT=85
EDGE_DISK_DANGER_PCT=95
EDGE_MEMORY_WARN_PCT=85
EDGE_MEMORY_DANGER_PCT=95
EDGE_LOAD_WARN_PER_CPU=2

# Optional internal switch/router/AP SNMP polling.
# Keep this file root-readable only. Communities are never sent to the central server.
NETWORK_DEVICE_SNMP_ENABLED=false
NETWORK_DEVICE_SNMP_COMMUNITY=
NETWORK_DEVICE_SNMP_DEFAULT_VERSION=2c
NETWORK_DEVICE_SNMP_DEFAULT_PORT=161
NETWORK_DEVICE_SNMP_TIMEOUT_SECONDS=2
NETWORK_DEVICE_SNMP_RETRIES=1
NETWORK_DEVICE_SNMP_TARGETS=[]
SNMP_AGENT_LISTEN_ADDRESS=udp:0.0.0.0:161
SNMP_AGENT_ALLOWED_NETWORK=192.168.1.0/24
VLAN_PASSIVE_SCAN_ENABLED=true
VLAN_PASSIVE_SCAN_INTERFACE=any
VLAN_PASSIVE_SCAN_SECONDS=2

# Optional: lightweight AI helper for local edge summaries
# OpenAI-compatible endpoint examples:
#   118 LLM Ops: http://192.168.1.118:8090/v1
#   Ollama OpenAI shim: http://192.168.1.118:11434/v1
EDGE_AI_ENABLED=false
EDGE_AI_BASE_URL=
EDGE_AI_MODEL=metro-report:latest
EDGE_AI_API_KEY=
EDGE_AI_TIMEOUT_MS=30000
EDGE_AI_MAX_TOKENS=500

# Optional: Uptime Kuma push monitor URL
# Example: http://192.168.1.33:3001/api/push/<token>
UPTIME_KUMA_PUSH_URL=
UPTIME_KUMA_PUSH_TIMEOUT_MS=10000

# Optional: NETSCOUT Pulse local status polling. The collector works around the
# device's malformed CGI header and sends timestamped live values to /pulse/vitals/.
PULSE_LOCAL_POLL_ENABLED=false
PULSE_LOCAL_HOST=
PULSE_LOCAL_SERIAL_NUMBER=
PULSE_LOCAL_MAC_ADDRESS=
PULSE_LOCAL_PORT=80
PULSE_LOCAL_STATUS_PATH=/cgi-bin/ledstatus.cgi
PULSE_LOCAL_TIMEOUT_MS=15000
